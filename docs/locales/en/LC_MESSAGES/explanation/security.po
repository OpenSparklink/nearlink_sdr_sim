msgstr "0x04"

#: ../../explanation/security.md:34
msgid "确认值校验失败"
msgstr "Confirm value check failed"

#: ../../explanation/security.md:34
msgid "0x05"
msgstr "0x05"

#: ../../explanation/security.md:34
msgid "配对不支持"
msgstr "Pairing not supported"

