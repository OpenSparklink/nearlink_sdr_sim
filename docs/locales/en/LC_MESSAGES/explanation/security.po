msgstr "0x01"

#: ../../explanation/security.md:34
msgid "密码输入失败"
msgstr "Passkey entry failed"

#: ../../explanation/security.md:34
msgid "0x02"
msgstr "0x02"

#: ../../explanation/security.md:34
msgid "带外数据不可用"
msgstr "Out-of-band data unavailable"

#: ../../explanation/security.md:34
msgid "0x03"
msgstr "0x03"

#: ../../explanation/security.md:34
msgid "鉴权要求不满足"
msgstr "Authentication requirements not met"

#: ../../explanation/security.md:34
