msgid "CRC 校验 (§6.9)"
msgstr "CRC Verification (§6.9)"

#: ../../explanation/physical-layer.md:214
msgid "SLE 使用四种 CRC:"
msgstr "SLE uses four CRC variants:"

#: ../../explanation/physical-layer.md
msgid "生成多项式"
msgstr "Generator Polynomial"

#: ../../explanation/physical-layer.md
msgid "CRC12"
msgstr "CRC12"

#: ../../explanation/physical-layer.md
#, python-brace-format
msgid "$D^{12}+D^{11}+D^3+D^2+D+1$"
msgstr "$D^{12}+D^{11}+D^3+D^2+D+1$"

#: ../../explanation/physical-layer.md
msgid "A 组控制信息"
msgstr "Group A control information"

#: ../../explanation/physical-layer.md
msgid "CRC24A"
msgstr "CRC24A"

#: ../../explanation/physical-layer.md
#, python-brace-format
msgid "$D^{24}+D^{23}+D^{18}+D^{17}+D^{14}+D^{11}+D^{10}+D^7+D^6+D^5+D^4+D^3+D+1$"
msgstr "$D^{24}+D^{23}+D^{18}+D^{17}+D^{14}+D^{11}+D^{10}+D^7+D^6+D^5+D^4+D^3+D+1$"

#: ../../explanation/physical-layer.md
