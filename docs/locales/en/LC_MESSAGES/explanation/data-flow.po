msgstr "`mac_to_iq()`"

#: ../../explanation/data-flow.md:7
msgid "TX"
msgstr "TX"

#: ../../explanation/data-flow.md:7
msgid "MAC 字节 → IQ 信号"
msgstr "MAC bytes → IQ signal"

#: ../../explanation/data-flow.md:7
msgid "`iq_to_mac()`"
msgstr "`iq_to_mac()`"

#: ../../explanation/data-flow.md:7
msgid "RX"
msgstr "RX"

#: ../../explanation/data-flow.md:7
msgid "IQ 信号 → MAC 字节"
msgstr "IQ signal → MAC bytes"

#: ../../explanation/data-flow.md:7
msgid "`signaling_to_iq()`"
msgstr "`signaling_to_iq()`"

#: ../../explanation/data-flow.md:7
msgid "信令对象 → IQ"
msgstr "Signaling object → IQ"

#: ../../explanation/data-flow.md:7
msgid "`iq_to_signaling()`"
msgstr "`iq_to_signaling()`"

#: ../../explanation/data-flow.md:7
msgid "IQ → 信令对象"
msgstr "IQ → signaling object"

#: ../../explanation/data-flow.md:7
msgid "`bytes_to_bits()`"
msgstr "`bytes_to_bits()`"

#: ../../explanation/data-flow.md:7
msgid "工具"
msgstr "Utility"

#: ../../explanation/data-flow.md:7
