msgstr ""

#: ../../../src/nearlink_sdr/common/polar.py:179
msgid "约定：正 LLR 表示比特 0 的可能性更高。"
msgstr ""

#: ../../../src/nearlink_sdr/common/polar.py:185
msgid "SSC 优化的 SC 解码。"
msgstr "SSC-optimized SC decoding."

#: ../../../src/nearlink_sdr/common/polar.py:187
msgid ""
"rate-0 子树: 所有位为冻结位, 直接置零。 rate-1 子树: 硬判决 LLR 得到编码位, 极性变换得到信息位。 partial "
"子树: 标准 f/g 递归。"
msgstr ""

