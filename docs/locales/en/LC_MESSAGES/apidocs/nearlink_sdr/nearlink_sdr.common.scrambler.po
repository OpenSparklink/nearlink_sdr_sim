#: ../../../src/nearlink_sdr/common/scrambler.py:7
msgid "信道比特加扰 -- TXS-10002-2025 标准 6.10.4"
msgstr "Channel bit scrambling -- TXS-10002-2025 Standard 6.10.4"

#: ../../../src/nearlink_sdr/common/scrambler.py:9
msgid "使用 7bit 左移 Galois LFSR, 生成多项式 x^7 + x^4 + 1。 对编码后的比特序列进行异或加扰, 用于数据白化。"
msgstr ""
"Uses a 7-bit left-shift Galois LFSR with generator polynomial x^7 + x^4 +"
" 1. XOR scrambles the encoded bit sequence for data whitening."

