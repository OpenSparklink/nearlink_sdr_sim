msgstr ""
"+1: Recommend increasing MCS (good link quality)     -1: Recommend "
"decreasing MCS (poor link quality)      0: Keep current MCS"

#: ../../../src/nearlink_sdr/mac/qos.py:556
msgid "应用 MCS 调整建议并返回新 MCS。"
msgstr "Apply MCS adjustment recommendation and return the new MCS."

#: ../../../src/nearlink_sdr/mac/qos.py:564
msgid "编码 LQI 字段 (8 bit): 前 4 bit MCS, 后 4 bit 预留。"
msgstr "Encode the LQI field (8 bit): first 4 bits MCS, last 4 bits reserved."

#: ../../../src/nearlink_sdr/mac/qos.py:573
msgid "解码 LQI 字段, 提取 MCS 指示。"
msgstr "Decode the LQI field and extract the MCS indication."

