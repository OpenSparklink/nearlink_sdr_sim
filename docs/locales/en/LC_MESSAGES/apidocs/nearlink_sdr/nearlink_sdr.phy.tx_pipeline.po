#: ../../../src/nearlink_sdr/phy/tx_pipeline.py:106
msgid ""
"frame_type : 帧类型 (1-4) mcs_index : 编码调制索引 (0-12) pid : 24-bit PID, 用于生成同步字 "
"whitening_seed : 7-bit 加扰种子 crc_seed : CRC 初始值 crc_len : CRC 比特长度 (24 或 32) "
"ctrl_bits_len : 控制信息有效比特数 (不含 CRC12) pilot_interval : 导频间隔 (4/8/16), 0 表示无导频"
" sps : 每符号采样数 (脉冲成型用) symbol_rate_mhz : 符号速率 (MHz)"
msgstr ""
"frame_type : Frame type (1-4). mcs_index : MCS index (0-12). pid : 24-bit "
"PID, used to generate the sync word. whitening_seed : 7-bit scrambling seed."
" crc_seed : CRC initial value. crc_len : CRC bit length (24 or 32). "
"ctrl_bits_len : Control information effective bit count (excluding CRC12). "
"pilot_interval : Pilot interval."

