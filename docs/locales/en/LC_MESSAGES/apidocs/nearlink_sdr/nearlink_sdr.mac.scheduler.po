#: ../../../src/nearlink_sdr/mac/scheduler.py:972
msgid "Args:     event_start_us: 事件起始时间 (μs)。"
msgstr "Args:     event_start_us: Event start time (us)."

#: ../../../src/nearlink_sdr/mac/scheduler.py:967
msgid "Returns:     (start_us, end_us) 先发窗口区间。"
msgstr "Returns:     (start_us, end_us) first-send window interval."

