msgid ""
"Attributes:     timing: 事件计时参数。     anchor_slot: 锚点时隙 (基础时隙顺序号)。     "
"anchor_offset_us: 事件组起始偏移 (μs)。"
msgstr ""
"Attributes:     timing: Event timing parameters.     anchor_slot: Anchor "
"time slot (base time slot sequence number).     anchor_offset_us: Event "
"group start offset (us)."

#: ../../../src/nearlink_sdr/mac/scheduler.py:946
msgid "锚点绝对时间 (μs)。"
msgstr "Anchor absolute time (us)."

#: ../../../src/nearlink_sdr/mac/scheduler.py:954
msgid "计算指定事件组内每个事件的起始时间。"
msgstr ""
"Calculate the start time of each event within the specified event group."

#: ../../../src/nearlink_sdr/mac/scheduler.py:956
msgid "Args:     group_index: 第几个事件组 (从 0 开始)。"
msgstr "Args:     group_index: Event group index (starting from 0)."

