msgstr "Returns:     [(start_us, end_us), ...] list of time intervals."

#: ../../../src/nearlink_sdr/mac/scheduler.py:663
msgid ""
"Attributes:     effective_slot: 信令生效时隙 (32 bit, 基础时隙)。     smf_interval: 两个 "
"SMF 之间的间隔 (16 bit, 基础时隙)。     frame_type: 无线帧类型指示 (4 bit)。     bandwidth: "
"带宽指示 (2 bit, 0=1M/1=2M/2=4M)。     pilot_density: 导频密度指示 (2 bit)。     "
"channel_count: 可用频点个数 (8 bit)。     channel_table: 频点表。"
msgstr ""
"Attributes:     effective_slot: Signaling effective time slot (32 bit, base "
"time slot).     smf_interval: Interval between two SMFs (16 bit, base time "
