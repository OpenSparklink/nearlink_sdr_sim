msgid "计算一个事件中后发窗口的时间区间。"
msgstr "Calculate the time interval of the responder window in an event."

#: ../../../src/nearlink_sdr/mac/scheduler.py:975
msgid "Returns:     (start_us, end_us) 后发窗口区间。"
msgstr "Returns:     (start_us, end_us) second-send window interval."

