msgid "Args:     group_index: 事件组索引。"
msgstr "Args:     group_index: Event group index."

#: ../../../src/nearlink_sdr/mac/scheduler.py:985
#, python-brace-format
msgid ""
"Returns:     [{\"event_start\": int, \"tx_window\": (s, e), \"rx_window\": "
"(s, e)}, ...]"
msgstr ""
"Returns:     [{\"event_start\": int, \"tx_window\": (s, e), \"rx_window\": "
"(s, e)}, ...]"

#: ../../../src/nearlink_sdr/mac/scheduler.py:986
msgid "计算下一个事件组的起始时间。"
msgstr "Calculate the start time of the next event group."

