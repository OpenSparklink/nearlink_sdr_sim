msgstr "Args: current_us: whenprevioustime (μs)."

#: ../../../src/nearlink_sdr/mac/scheduler.py:991
msgid "Returns:     下一个事件组起始时间 (μs)。"
msgstr "Returns:     Next event group start time (us)."

#: ../../../src/nearlink_sdr/mac/scheduler.py:1081
msgid "Polar 编码分段 [00001]~[11111] 各对应一个 8 bit 间隔值 (μs)。"
msgstr ""
"Polar coded segments [00001]~[11111] each correspond to an 8-bit interval "
"value (us)."

