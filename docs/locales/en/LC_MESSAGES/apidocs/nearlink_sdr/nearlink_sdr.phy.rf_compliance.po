#: ../../apidocs/nearlink_sdr/nearlink_sdr.phy.rf_compliance.md
msgid "参数"
msgstr "Parameters"

#: ../../../src/nearlink_sdr/phy/rf_compliance.py:1210
msgid "频段类型。"
msgstr "frequency band type."

#: ../../../src/nearlink_sdr/phy/rf_compliance.py:1211
msgid "调制类型 (\"GFSK\", \"BPSK/QPSK\", \"8PSK\")。"
msgstr "modulation type (\"GFSK\", \"BPSK/QPSK\", \"8PSK\")."

#: ../../../src/nearlink_sdr/phy/rf_compliance.py:1212
msgid "初始频率偏差 (kHz)。"
msgstr "Initial frequency deviation (kHz)."

#: ../../../src/nearlink_sdr/phy/rf_compliance.py:1213
msgid "频率漂移 (kHz)。"
msgstr "Frequency drift (kHz)."

#: ../../../src/nearlink_sdr/phy/rf_compliance.py:1214
msgid "频率漂移率 (Hz/us)。"
msgstr "Frequency drift rate (Hz/us)."

#: ../../../src/nearlink_sdr/phy/rf_compliance.py:1215
msgid "载波频率 (MHz), sub-1GHz 时用于 ppm 校验。"
msgstr "Carrier frequency (MHz), used for ppm check at sub-1GHz."

#: ../../../src/nearlink_sdr/phy/rf_compliance.py:1224
msgid "在参考灵敏度 +6 dB 处, 误差应不大于 ±6 dB。"
msgstr "At reference sensitivity +6 dB, the error shall not exceed ±6 dB."

#: ../../../src/nearlink_sdr/phy/rf_compliance.py:1231
msgid "标准要求接收机杂散发射应符合国家频谱法规。 默认限值 -57 dBm (30 MHz ~ 1 GHz 频段, GB/T 9254.1 限值)。"
msgstr ""
"The standard requires receiver spurious emissions to comply with national"
" spectrum regulations. Default limit -57 dBm (30 MHz - 1 GHz band, GB/T "
"9254.1 limit)."

#: ../../../src/nearlink_sdr/phy/rf_compliance.py:1238
msgid "同步信号和测量信号 NRMSE 均不超过 25%, 且两者差值不超过 ±2 dB。"
msgstr ""
"Sync signal and measurement signal NRMSE shall not exceed 25%, and their "
"difference shall not exceed ±2 dB."

#: ../../../src/nearlink_sdr/phy/rf_compliance.py:1259
msgid "对宽信道 (1/2/4 MHz, 表56) 返回 dBm/MHz; 对窄信道 (100-500 kHz, 表57) 返回 dBm/100kHz。"
msgstr ""
"For wide channels (1/2/4 MHz, Table 56) returns dBm/MHz; for narrow "
"channels (100-500 kHz, Table 57) returns dBm/100kHz."

#: ../../../src/nearlink_sdr/phy/rf_compliance.py:1266
msgid "信道带宽 (kHz)。"
msgstr "channel bandwidth (kHz)."

#: ../../../src/nearlink_sdr/phy/rf_compliance.py:1267
msgid "MCS 索引。None 时返回 GFSK 灵敏度。"
msgstr "MCS index. Returns GFSK sensitivity when None."

#: ../../../src/nearlink_sdr/phy/rf_compliance.py:1280
msgid ""
"fc = 499.2 + Nc * 124.8  (Nc in 0..79) 特殊信道: 125 -> 7542.6, 126 -> "
"18041.8, 127 -> 8541.0"
msgstr ""
"fc = 499.2 + Nc * 124.8  (Nc in 0..79) Special channels: 125 -> 7542.6, "
"126 -> 18041.8, 127 -> 8541.0"

