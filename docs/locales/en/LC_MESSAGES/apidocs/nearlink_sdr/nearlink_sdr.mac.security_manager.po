"     frame_type: 帧类型 (用于 IV 计算)。     link_id: 链路标识 (用于 IV 计算)。"
msgstr ""
"Attributes:     session_key: Session key (16 bytes).     iv_base: "
"Initialization vector base (8 bytes).     direction: Transmission "
"direction (0=G->T, 1=T->G).     mic_len: MIC length (bytes, 4/8/12/16)."
"     frame_type: Frame type (for IV calculation).     link_id: Link "
"identifier (for IV calculation)."

#: ../../../src/nearlink_sdr/mac/security_manager.py:829
msgid "构建 CCM nonce (13 字节)。"
msgstr "build CCM nonce (13 byte)."

#: ../../../src/nearlink_sdr/mac/security_manager.py:831
msgid ""
"build_ccm_nonce_async 返回 16 字节 B0 块: flag(1B) | nonce(13B) | "
"data_length(2B) AESCCM 需要 13 字节 nonce 部分。"
msgstr ""
"build_ccm_nonce_async returns a 16-byte B0 block: flag(1B) | nonce(13B) |"
" data_length(2B) AESCCM requires the 13-byte nonce part."

