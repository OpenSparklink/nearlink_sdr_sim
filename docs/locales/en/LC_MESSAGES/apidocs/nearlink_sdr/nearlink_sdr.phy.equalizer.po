msgstr "Parameters"

#: ../../../src/nearlink_sdr/phy/equalizer.py:48
#: ../../../src/nearlink_sdr/phy/equalizer.py:57
msgid "接收信号 (时域)。"
msgstr "Received signal (time domain)."

#: ../../../src/nearlink_sdr/phy/equalizer.py:49
msgid "信道频率响应 H[k], 长度等于 rx_signal 的 FFT 长度。"
msgstr ""
"Channel frequency response H[k], length equals the FFT length of rx_signal."

#: ../../apidocs/nearlink_sdr/nearlink_sdr.phy.equalizer.md
msgid "返回"
msgstr "Returns"

#: ../../../src/nearlink_sdr/phy/equalizer.py:51
#: ../../../src/nearlink_sdr/phy/equalizer.py:61
msgid "均衡后的时域信号。"
msgstr "Equalized time-domain signal."

#: ../../../src/nearlink_sdr/phy/equalizer.py:55
msgid "H_mmse[k] = conj(H[k]) / (|H[k]|^2 + sigma^2)"
msgstr "H_mmse[k] = conj(H[k]) / (|H[k]|^2 + sigma^2)"

#: ../../../src/nearlink_sdr/phy/equalizer.py:58
msgid "信道频率响应 H[k]。"
msgstr "channel frequency response H[k]."

#: ../../../src/nearlink_sdr/phy/equalizer.py:59
msgid "噪声方差 sigma^2。"
msgstr "Noise variance sigma^2."

#: ../../../src/nearlink_sdr/phy/equalizer.py:62
msgid "H_est[k] = Y[k] / X[k]"
msgstr "H_est[k] = Y[k] / X[k]"

#: ../../../src/nearlink_sdr/phy/equalizer.py:64
msgid "接收到的训练序列。"
msgstr "Received training sequence."

#: ../../../src/nearlink_sdr/phy/equalizer.py:65
msgid "已知的发送训练序列。"
msgstr "Known transmit training sequence."

#: ../../../src/nearlink_sdr/phy/equalizer.py:66
msgid "FFT 长度, 默认为信号长度。"
msgstr "FFT length, defaults to signal length."

#: ../../../src/nearlink_sdr/phy/equalizer.py:68
msgid "估计的信道频率响应。"
msgstr "Estimated channel frequency response."

#: ../../../src/nearlink_sdr/phy/equalizer.py:69
#, python-brace-format
msgid "计算 MMSE 最优 FIR 滤波器系数:     w = R^{-1} p 其中 R = h自相关 + 噪声, p = h与期望延迟的互相关。"
msgstr ""
"Compute MMSE optimal FIR filter coefficients:     w = R^{-1} p where R = "
"autocorrelation of h + noise, p = cross-correlation of h with the desired"
" delay."

#: ../../../src/nearlink_sdr/phy/equalizer.py:73
msgid "接收信号。"
msgstr "Received signal."

#: ../../../src/nearlink_sdr/phy/equalizer.py:74
msgid "信道冲激响应 h[0], h[1], ..., h[L-1]。"
msgstr "Channel impulse response h[0], h[1], ..., h[L-1]."

#: ../../../src/nearlink_sdr/phy/equalizer.py:75
msgid "噪声方差。"
msgstr "Noise variance."

#: ../../../src/nearlink_sdr/phy/equalizer.py:76
msgid "均衡器 FIR 长度。"
msgstr "equalizer FIR length."

#: ../../../src/nearlink_sdr/phy/equalizer.py:78
msgid "均衡后的信号。"
msgstr "Equalized signal."

#: ../../../src/nearlink_sdr/phy/equalizer.py:76
msgid "接收符号。"
msgstr "receive symbol."

#: ../../../src/nearlink_sdr/phy/equalizer.py:77
msgid "每个符号的信道系数 (与 rx_symbols 等长)。"
msgstr "Channel coefficient per symbol (same length as rx_symbols)."

#: ../../../src/nearlink_sdr/phy/equalizer.py:78
msgid "噪声方差, 仅 MMSE 使用。"
msgstr "Noise variance, used only by MMSE."

#: ../../../src/nearlink_sdr/phy/equalizer.py:79
msgid "\"zf\" 或 \"mmse\"。"
msgstr "\"zf\" or \"mmse\"."

#: ../../../src/nearlink_sdr/phy/equalizer.py:81
msgid "均衡后的符号。"
msgstr "Equalized symbols."

