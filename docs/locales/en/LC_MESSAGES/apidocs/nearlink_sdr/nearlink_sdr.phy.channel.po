#: ../../apidocs/nearlink_sdr/nearlink_sdr.phy.channel.md:189
msgid "Initialization"
msgstr "Initialization"

#: ../../../src/nearlink_sdr/phy/channel.py:200
msgid "仅加 AWGN 噪声 (保持向后兼容)。"
msgstr "Add AWGN noise only (for backward compatibility)."

#: ../../../src/nearlink_sdr/phy/channel.py:208
msgid "按 config 类型应用衰落 + AWGN, 同时缓存信道系数到 last_taps。"
msgstr ""
"Apply fading + AWGN according to config type, caching channel coefficients "
"in last_taps."

#: ../../../src/nearlink_sdr/phy/channel.py:217
msgid "上一次 apply_fading 使用的信道系数, 供均衡器使用。"
msgstr ""
"Channel coefficients from the last apply_fading call, for use by the "
"equalizer."

#: ../../../src/nearlink_sdr/phy/channel.py:225
msgid "返回信道抽头系数矩阵 (n_taps × n_symbols), 用于均衡器。"
msgstr ""
"Return the channel tap coefficient matrix (n_taps × n_symbols) for use by "
"the equalizer."

#: ../../../src/nearlink_sdr/phy/channel.py:227
msgid "对于平坦衰落: 返回 (1, n_symbols)。 对于多径: 返回 (max_delay+1, n_symbols)。"
msgstr ""
"For flat fading: returns (1, n_symbols). For multipath: returns "
"(max_delay+1, n_symbols)."

#: ../../../src/nearlink_sdr/phy/channel.py:234
msgid "AWGN 噪声方差 (单边, 假设单位信号功率)。"
msgstr "AWGN noise variance (one-sided, assuming unit signal power)."

#: ../../../src/nearlink_sdr/phy/channel.py:258
msgid "生成 Rayleigh 衰落系数。"
msgstr "Generate Rayleigh fading coefficients."

#: ../../../src/nearlink_sdr/phy/channel.py:260
msgid ""
"max_doppler_hz > 0 时使用 Jakes 求和正弦模型, 产生具有经典 U 形 功率谱密度的时间相关衰落; 否则为准静态 "
"(整段同一系数)。"
msgstr ""
"When max_doppler_hz > 0, use the Jakes sum-of-sinusoids model to produce "
"time-correlated fading with the classic U-shaped power spectral density; "
"otherwise quasi-static (same coefficient for the entire block)."

#: ../../../src/nearlink_sdr/phy/channel.py:266
msgid "生成 Rician 衰落系数。K = LOS功率 / 散射功率。"
msgstr "Generate Rician fading coefficients. K = LOS power / scatter power."

#: ../../../src/nearlink_sdr/phy/channel.py:274
msgid "Jakes 求和正弦法生成时间相关衰落序列。"
msgstr ""
"Jakes sum-of-sinusoids method to generate time-correlated fading sequences."

#: ../../../src/nearlink_sdr/phy/channel.py:276
msgid "使用 N_osc 个正弦分量叠加, 到达角均匀分布, 初始相位随机。 输出自相关逼近 J₀(2π·f_d·Δt)。"
msgstr ""
"Superimpose N_osc sinusoidal components with uniformly distributed angles of"
" arrival and random initial phases. The output autocorrelation approximates "
"J₀(2π·f_d·Δt)."

#: ../../../src/nearlink_sdr/phy/channel.py:279
msgid "参考: W.C. Jakes, \"Microwave Mobile Communications\", 1974"
msgstr "reference: W.C. Jakes, \"Microwave Mobile Communications\", 1974"

#: ../../../src/nearlink_sdr/phy/channel.py:282
msgid "应用多径信道 (FIR 卷积模型)。"
msgstr "Apply multipath channel (FIR convolution model)."

#: ../../../src/nearlink_sdr/phy/channel.py:291
msgid "用给定的抽头系数对信号做 FIR 多径卷积。"
msgstr ""
"Perform FIR multipath convolution on the signal with the given tap "
"coefficients."

#: ../../../src/nearlink_sdr/phy/channel.py:299
msgid "生成多径信道抽头系数。"
msgstr "Generate multipath channel tap coefficients."

#: ../../../src/nearlink_sdr/phy/channel.py:301
msgid ""
"返回 (n_taps, n) 的复数矩阵,每行对应一个多径分量。 max_doppler_hz > 0 时每条径独立使用 Jakes 模型产生时变系数。"
msgstr ""
"Return a complex matrix of shape (n_taps, n), where each row corresponds to "
"a multipath component. When max_doppler_hz > 0, each path independently uses"
" the Jakes model to generate time-varying coefficients."

#: ../../../src/nearlink_sdr/phy/channel.py:315
msgid "计算 Jakes 衰落序列的归一化自相关函数, 用于验证 J₀ 特性。"
msgstr ""
"Compute the normalized autocorrelation function of a Jakes fading sequence "
"for verifying J₀ characteristics."

#: ../../../src/nearlink_sdr/phy/channel.py:317
#, python-brace-format
msgid "返回长度为 max_lag 的实数数组, r[k] = Re{E[h(n)·h*(n+k)]} / E[|h|²]。"
msgstr ""
"Return a real-valued array of length max_lag, r[k] = Re{E[h(n)·h*(n+k)]} / "
"E[|h|²]."

#: ../../../src/nearlink_sdr/phy/channel.py:323
msgid "理论自相关函数 J₀(2π·f_d·k/f_s), 供对比验证。"
msgstr ""
"Theoretical autocorrelation function J₀(2π·f_d·k/f_s) for comparison and "
"verification."

#: ../../../src/nearlink_sdr/phy/channel.py:334
msgid ""
"Attributes:     sir_db: 信号与干扰功率比 (dB), 即 S/I。     freq_offset_hz: "
"干扰信号中心频率相对有用信号的偏移 (Hz)。         0 表示同信道干扰。     interferer_bw_hz: 干扰信号带宽 "
"(Hz), 用于频谱成型。         0 表示与有用信号相同带宽 (不做滤波)。     seed: 随机种子。"
msgstr ""
"Attributes:     sir_db: Signal-to-interference power ratio (dB), i.e. S/I."
"     freq_offset_hz: Frequency offset of the interferer center frequency "
"relative to the useful signal (Hz).         0 means co-channel interference."
"     interferer_bw_hz: Interferer signal bandwidth (Hz), used for spectral "
"shaping.         0 means same bandwidth as the useful signal (no filtering)."
"     seed: Random seed."

#: ../../../src/nearlink_sdr/phy/channel.py:385
msgid "每个干扰源独立生成与有用信号等长的随机 IQ 序列, 按 SIR 缩放后叠加。 支持同信道和邻信道干扰 (通过频率偏移实现)。"
msgstr ""
"Each interference source independently generates a random IQ sequence of the"
" same length as the useful signal, scaled by SIR before superposition. "
"Supports co-channel and adjacent-channel interference (via frequency "
"offset)."

#: ../../../src/nearlink_sdr/phy/channel.py:388
msgid ""
"Args:     signal: 有用信号 (复数 IQ)。     interferers: 干扰源配置列表。     "
"sample_rate_hz: 采样率 (Hz)。     rng: 可选随机数生成器。"
msgstr ""
"Args:     signal: Useful signal (complex IQ).     interferers: List of "
"interference source configurations.     sample_rate_hz: Sample rate (Hz)."
"     rng: Optional random number generator."

#: ../../../src/nearlink_sdr/phy/channel.py:394
msgid "Returns:     叠加干扰后的信号。"
msgstr "Returns:     Signal after interference superposition."

#: ../../../src/nearlink_sdr/phy/channel.py:392
msgid ""
"Args:     signal: 纯净有用信号。     noise_signal: 含噪声的接收信号 (信号+噪声, 不含干扰)。     "
"interference_signal: 干扰叠加后的接收信号 (信号+噪声+干扰)。"
msgstr ""
"Args:     signal: Clean useful signal.     noise_signal: Noisy received "
"signal (signal + noise, without interference).     interference_signal: "
"Received signal after interference superposition (signal + noise + "
"interference)."

#: ../../../src/nearlink_sdr/phy/channel.py:397
msgid "Returns:     SINR (dB)。"
msgstr "Returns:     SINR (dB)。"
