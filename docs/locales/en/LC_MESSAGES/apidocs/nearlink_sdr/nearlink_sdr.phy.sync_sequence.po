#: ../../../src/nearlink_sdr/phy/sync_sequence.py:92
msgid "标准6.2.3.1:"
msgstr "standard6.2.3.1:"

#: ../../../src/nearlink_sdr/phy/sync_sequence.py:93
msgid "广播帧: 固定序列0x5A2BDA62"
msgstr "Broadcast frame: fixed sequence 0x5A2BDA62."

#: ../../../src/nearlink_sdr/phy/sync_sequence.py:94
msgid "其他帧: 24位逻辑链路标识 → 补\"10\" → BCH(31,26) → m31异或 → 补\"0\""
msgstr ""
"Other frames: 24-bit logical link identifier → append \"10\" → BCH(31,26)"
" → XOR with m31 → append \"0\"."

#: ../../apidocs/nearlink_sdr/nearlink_sdr.phy.sync_sequence.md
msgid "参数"
msgstr "Parameters"

#: ../../../src/nearlink_sdr/phy/sync_sequence.py:96
#: ../../../src/nearlink_sdr/phy/sync_sequence.py:110
msgid "24位逻辑链路标识，None表示广播帧"
msgstr "link_id_24: 24-bit logical link identifier, None for broadcast frames."

#: ../../apidocs/nearlink_sdr/nearlink_sdr.phy.sync_sequence.md
msgid "返回"
msgstr "Returns"

#: ../../../src/nearlink_sdr/phy/sync_sequence.py:98
msgid "32比特同步序列"
msgstr "32-bit sync sequence"

#: ../../../src/nearlink_sdr/phy/sync_sequence.py:99
msgid "标准6.2.3.1要求:"
msgstr "Standard 6.2.3.1 requirements:"

#: ../../../src/nearlink_sdr/phy/sync_sequence.py:100
msgid "不能出现7个或以上连续的0或1"
msgstr "Must not contain 7 or more consecutive 0s or 1s."

#: ../../../src/nearlink_sdr/phy/sync_sequence.py:101
msgid "不能出现26次或以上的0/1跳转"
msgstr "Must not contain 26 or more 0/1 transitions."

#: ../../../src/nearlink_sdr/phy/sync_sequence.py:102
msgid "不能和广播帧同步序列相同"
msgstr "Must not be identical to the broadcast frame sync word."

#: ../../../src/nearlink_sdr/phy/sync_sequence.py:106
msgid "标准6.2.3.2:"
msgstr "standard6.2.3.2:"

#: ../../../src/nearlink_sdr/phy/sync_sequence.py:107
msgid "广播帧: 固定序列0x7DE7585C6D226540"
msgstr "Broadcast frame: fixed sequence 0x7DE7585C6D226540."

#: ../../../src/nearlink_sdr/phy/sync_sequence.py:108
msgid "其他帧: 24位逻辑链路标识 → BCH(63,24) → m63异或 → 补\"0\""
msgstr ""
"Other frames: 24-bit logical link identifier → BCH(63,24) → XOR with m63 "
"→ append \"0\"."

#: ../../../src/nearlink_sdr/phy/sync_sequence.py:112
msgid "64比特同步序列"
msgstr "64-bit sync sequence"

#: ../../../src/nearlink_sdr/phy/sync_sequence.py:113
msgid "标准6.2.3.3: 两个相同的31长m序列串联。 经BPSK调制后产生62个符号。"
msgstr ""
"Standard 6.2.3.3: concatenation of two identical length-31 m-sequences. "
"After BPSK modulation, produces 62 symbols."

#: ../../../src/nearlink_sdr/phy/sync_sequence.py:116
msgid "m31序列编号 0~5，基础广播信道为0"
msgstr "m31 sequence index 0~5, base broadcast channel is 0"

#: ../../../src/nearlink_sdr/phy/sync_sequence.py:118
msgid "62比特序列"
msgstr "62-bit sequence"

#: ../../../src/nearlink_sdr/phy/sync_sequence.py:120
msgid "标准6.2.3.4: 两个相同的63长m序列串联。 经BPSK调制后产生126个符号。"
msgstr ""
"Standard 6.2.3.4: concatenation of two identical length-63 m-sequences. "
"After BPSK modulation, produces 126 symbols."

#: ../../../src/nearlink_sdr/phy/sync_sequence.py:123
msgid "m63序列编号 0~5，基础广播信道为0"
msgstr "m63 sequence index 0~5, base broadcast channel is 0"

#: ../../../src/nearlink_sdr/phy/sync_sequence.py:125
msgid "126比特序列"
msgstr "Generate the 126-bit sequence for sync signal 4."

#: ../../../src/nearlink_sdr/phy/sync_sequence.py:127
msgid "标准6.2.3.5: 使用安全随机函数生成256比特安全序列, 先发/后发节点分别取偶数/奇数索引比特。"
msgstr ""
"Standard 6.2.3.5: use the security random function to generate a 256-bit "
"security sequence; initiator/responder nodes take even/odd indexed bits "
"respectively."

#: ../../../src/nearlink_sdr/phy/sync_sequence.py:130
#: ../../../src/nearlink_sdr/phy/sync_sequence.py:137
msgid "安全随机种子 (16字节)"
msgstr "secure random seed (16 byte)"

#: ../../../src/nearlink_sdr/phy/sync_sequence.py:131
#: ../../../src/nearlink_sdr/phy/sync_sequence.py:138
msgid "起始调度时隙号"
msgstr "start scheduling slot number"

#: ../../../src/nearlink_sdr/phy/sync_sequence.py:132
#: ../../../src/nearlink_sdr/phy/sync_sequence.py:139
msgid "同步序列长度 [32, 64, 128]"
msgstr "sync sequence length [32, 64, 128]"

#: ../../../src/nearlink_sdr/phy/sync_sequence.py:133
#: ../../../src/nearlink_sdr/phy/sync_sequence.py:140
msgid "True=先发节点, False=后发节点"
msgstr "True= initiator node, False= responder node"

#: ../../../src/nearlink_sdr/phy/sync_sequence.py:134
#: ../../../src/nearlink_sdr/phy/sync_sequence.py:141
msgid "0=AES-CMAC, 1=HMAC-SM3"
msgstr "0=AES-CMAC, 1=HMAC-SM3"

#: ../../../src/nearlink_sdr/phy/sync_sequence.py:134
msgid "标准6.2.3.6: 与同步信号5生成方式相同, 区别仅在调制方式 (BPSK vs GFSK)。"
msgstr ""
"Standard 6.2.3.6: same generation method as sync signal 5, differing only"
" in modulation scheme (BPSK vs GFSK)."

