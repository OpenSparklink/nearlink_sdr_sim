#: ../../../src/nearlink_sdr/mac/link_manager.py:143
msgid ""
"IDLE        -- 初始待机 BROADCASTING -- 广播态，周期发送基础/扩展广播帧（7.1.1） SCANNING    "
"-- 发现态，接收广播帧（7.1.2） ACCESSING   -- 接入态，发送接入请求/等待响应（7.1.3） CONNECTED   -- "
"链接态，异步数据链路已建立 PAIRING     -- 配对态，执行安全流程（9.2） DORMANT     -- "
"休眠态，保持链路但停止数据传输（7.2.14） DISCONNECTED -- 链路已断开"
msgstr ""

