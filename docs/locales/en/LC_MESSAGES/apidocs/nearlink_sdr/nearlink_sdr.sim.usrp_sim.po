"PHY full-chain loopback (CRC → Polar → modulation → channel → "
"demodulation → decoding → CRC)"

#: ../../../src/nearlink_sdr/sim/usrp_sim.py:15
msgid "MAC 数据帧环回 (AsyncDataFrame 打包 → PHY → 环回 → PHY → 解包)"
msgstr ""
"MAC data frame loopback (AsyncDataFrame packing → PHY → loopback → PHY → "
"unpacking)"

#: ../../../src/nearlink_sdr/sim/usrp_sim.py:16
