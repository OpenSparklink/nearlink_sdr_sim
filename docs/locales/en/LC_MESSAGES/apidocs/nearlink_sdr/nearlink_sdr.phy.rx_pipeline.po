#: ../../../src/nearlink_sdr/phy/rx_pipeline.py:7
msgid "物理层接收流水线 -- TXS-10002-2025 标准"
msgstr "Physical layer receive pipeline — TXS-10002-2025 standard"

#: ../../../src/nearlink_sdr/phy/rx_pipeline.py:9
msgid ""
"完成 TX 发射链路的逆操作: IQ 信号 → 帧同步 → 匹配滤波/解调 → 解扰 → Polar 解码 → CRC 校验, 还原 MAC 层载荷。"
msgstr ""
"Reverse the TX transmit chain: IQ signal → frame synchronization → matched "
"filter / demodulation → descrambling → Polar decoding → CRC check, "
"recovering the MAC layer payload."

