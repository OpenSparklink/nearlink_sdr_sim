#: ../../../src/nearlink_sdr/phy/multitone.py:7
msgid "多音信号生成器 -- TXS-10002-2025 标准 6.2.1.3"
msgstr "Multi-tone signal generator — TXS-10002-2025 standard 6.2.1.3"

#: ../../../src/nearlink_sdr/phy/multitone.py:9
#, python-brace-format
msgid "基带多音信号: S(t) = sum_{i=1}^{N} A_i * exp(j * (omega_i * t + phi_i))"
msgstr ""
"Baseband multi-tone signal: S(t) = sum_{i=1}^{N} A_i * exp(j * (omega_i *"
" t + phi_i))"

#: ../../../src/nearlink_sdr/phy/multitone.py:11
msgid "标准规定 N = 1, 2, 4, 8, 各音等幅、等间隔、对称分布。 测量信号 2 (6.2.4.2) 引用本模块生成多音波形。"
msgstr ""
"The standard specifies N = 1, 2, 4, 8, with equal amplitude, equal "
"spacing, and symmetric distribution. Measurement signal 2 (6.2.4.2) "
"references this module to generate multi-tone waveforms."

