#: ../../../src/nearlink_sdr/phy/measurement_frame.py:422
msgid "同步字段由 N_sync 个相同符号重复组成, 每个符号经过插零时域扩展。 总长度: N_sync * K * L 个码片。"
msgstr ""
"The sync field consists of N_sync identical repeated symbols, each "
"undergoing zero-insertion time-domain spreading. Total length: N_sync * K * "
"L chips."

#: ../../../src/nearlink_sdr/phy/measurement_frame.py:425
msgid "Args:     config: UWB 脉冲配置。"
msgstr "Args:     config: UWB pulse configuration."

#: ../../../src/nearlink_sdr/phy/measurement_frame.py:428
msgid "Returns:     同步字段码片序列。"
msgstr "Returns:     Sync field chip sequence."

#: ../../../src/nearlink_sdr/phy/measurement_frame.py:429
msgid "普通模式: 直接插零扩展。 安全模式 (L_cp>0 或 L_zero>0): 插零扩展后乘以加扰, 增加循环前缀和补零后缀。"
msgstr ""
"Normal mode: direct zero-insertion spreading. Security mode (L_cp>0 or "
"L_zero>0): after zero-insertion spreading, multiply by scrambling, then add "
"cyclic prefix and zero-padding suffix."

#: ../../../src/nearlink_sdr/phy/measurement_frame.py:436
msgid "测量字段由 M_seg 个测量子片段组成, 每个子片段包含 N_seg 个 CTS 符号, 相邻子片段之间有时间间隔。"
msgstr ""
"The measurement field consists of M_seg measurement sub-segments, each "
"containing N_seg CTS symbols, with time gaps between adjacent sub-segments."

#: ../../../src/nearlink_sdr/phy/measurement_frame.py:439
msgid ""
"Args:     config: UWB 脉冲配置。     cts_symbol_seq: CTS 测量符号序列, 默认使用 "
