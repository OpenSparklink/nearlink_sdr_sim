msgid "仅包含测量信号。"
msgstr "Contains only the measurement signal."

#: ../../../src/nearlink_sdr/phy/measurement_frame.py:365
msgid "测量信号序列。"
msgstr "Contains only the measurement signal."

#: ../../../src/nearlink_sdr/phy/measurement_frame.py:368
msgid "先发节点: 前导信号 | 同步信号 | 均衡保护 后发节点: 前导信号 | 同步信号 | 均衡保护 | 切换间隔 | 测量信号"
msgstr ""
"Initiator node: preamble | sync signal | equalization guard. Responder "
"node: preamble | sync signal | equalization guard | switch gap | "
"measurement signal."

#: ../../../src/nearlink_sdr/phy/measurement_frame.py:371
msgid "用于位置测量事件组的初始化阶段。"
msgstr "Used for the initialization phase of position measurement event groups."

#: ../../../src/nearlink_sdr/phy/measurement_frame.py:375
msgid "先发/后发节点结构相同: 前导信号 | 同步信号 | 均衡保护 | 切换间隔 | 测量信号"
msgstr ""
"Initiator/responder node frames share the same structure: preamble | sync"
" signal | equalization guard | switch gap | measurement signal."

#: ../../../src/nearlink_sdr/phy/measurement_frame.py:377
msgid "用于超宽带脉冲测量的初始化同步阶段, 测量信号应为窄带波形测量信号 1 或 N=1 的窄带波形测量信号 2。"
msgstr ""
"Used for the initialization synchronization phase of UWB pulse "
"measurement. The measurement signal should be narrowband waveform "
"measurement signal 1 or narrowband waveform measurement signal 2 with "
"N=1."

#: ../../../src/nearlink_sdr/phy/measurement_frame.py:382
msgid "帧结构: 前导信号 | 同步信号 | NACK 反馈序列"
msgstr "Frame structure: preamble | sync signal | NACK feedback sequence."

#: ../../../src/nearlink_sdr/phy/measurement_frame.py:384
msgid "无线帧类型 (1-4), 决定 m 序列长度。"
msgstr ""
"Radio frame type, used to determine the m-sequence length for semi-"
"reliable multicast feedback."

#: ../../../src/nearlink_sdr/phy/measurement_frame.py:385
msgid "m 序列索引, 由高层信令配置。"
msgstr "m-sequence index, configured by higher layer signaling."

#: ../../../src/nearlink_sdr/phy/measurement_frame.py:386
msgid "m 序列循环移位量, 由高层信令配置。"
msgstr "m-sequence cyclic shift amount, configured by higher layer signaling."

#: ../../../src/nearlink_sdr/phy/measurement_frame.py:387
msgid "符号速率, 用于前导码生成。"
msgstr "Symbol rate, used for preamble generation."

#: ../../../src/nearlink_sdr/phy/measurement_frame.py:389
msgid "NACK 反馈序列比特数组 (不含前导和同步, 由调用者拼接)。"
msgstr ""
"NACK feedback sequence bit array (excluding preamble and sync, to be "
"concatenated by the caller)."

#: ../../../src/nearlink_sdr/phy/measurement_frame.py:389
msgid "测量字段由 M_seg 个测量子片段组成, 每个子片段包含 N_seg 个 CTS 符号, 相邻子片段之间有时间间隔。"
msgstr ""
"The measurement field consists of M_seg measurement sub-segments, each "
"containing N_seg CTS symbols, with time gaps between adjacent sub-"
"segments."

#: ../../../src/nearlink_sdr/phy/measurement_frame.py:392
#: ../../../src/nearlink_sdr/phy/measurement_frame.py:398
#: ../../../src/nearlink_sdr/phy/measurement_frame.py:406
msgid "UWB 脉冲配置。"
msgstr "UWB pulse configuration."

#: ../../../src/nearlink_sdr/phy/measurement_frame.py:393
msgid "CTS 测量符号序列, 默认使用 config.symbol_seq。"
msgstr "CTS measurement symbol sequence, defaults to config.symbol_seq."

#: ../../../src/nearlink_sdr/phy/measurement_frame.py:395
msgid "测量字段码片序列。"
msgstr "Measurement field chip sequence."

#: ../../../src/nearlink_sdr/phy/measurement_frame.py:396
msgid "帧结构: 同步字段 | 测量字段"
msgstr "Frame structure: sync field | measurement field."

#: ../../../src/nearlink_sdr/phy/measurement_frame.py:399
msgid "CTS 测量符号序列, 默认使用同步符号序列。"
msgstr ""
"CTS measurement symbol sequence, defaults to the synchronization symbol "
"sequence."

#: ../../../src/nearlink_sdr/phy/measurement_frame.py:401
msgid "完整帧码片序列。"
msgstr "Full frame chip sequence."

#: ../../../src/nearlink_sdr/phy/measurement_frame.py:403
msgid "同步字段由 N_sync 个相同符号重复组成, 每个符号经过插零时域扩展。 总长度: N_sync * K * L 个码片。"
msgstr ""
"The sync field consists of N_sync identical repeated symbols, each "
"undergoing zero-insertion time-domain spreading. Total length: N_sync * K"
" * L chips."

#: ../../../src/nearlink_sdr/phy/measurement_frame.py:408
msgid "同步字段码片序列。"
msgstr "Synchronization field chip sequence."

#: ../../../src/nearlink_sdr/phy/measurement_frame.py:410
msgid "同步信号最后 1 比特为 1 时: 0101 (MSB 优先) 同步信号最后 1 比特为 0 时: 1010 (MSB 优先)"
msgstr ""
"When the last bit of the sync signal is 1: 0101 (MSB first). When the "
"last bit of the sync signal is 0: 1010 (MSB first)."

#: ../../../src/nearlink_sdr/phy/measurement_frame.py:413
msgid "同步信号的最后一个比特值 (0 或 1)。"
msgstr "sync_last_bit: Last bit value of the sync signal (0 or 1)."

#: ../../../src/nearlink_sdr/phy/measurement_frame.py:415
msgid "4 比特均衡保护序列。"
msgstr "4-bit equalization guard sequence."

