#: ../../../src/nearlink_sdr/phy/control_info.py:7
msgid "物理层控制信息 -- TXS-10002-2025 标准 6.4"
msgstr "Physical layer control information — TXS-10002-2025 standard 6.4"

#: ../../../src/nearlink_sdr/phy/control_info.py:9
msgid ""
"A 组: 无线帧类型 1 和 2, CRC12, 种子为同步序列低 12 位。 B 组: 无线帧类型 3 和 4, CRC24B, 种子 "
"0x555555, CRC 与 LLID 异或。"
msgstr ""
"Group A: radio frame types 1 and 2, CRC12, seed is the lower 12 bits of "
"the sync word. Group B: radio frame types 3 and 4, CRC24B, seed 0x555555,"
" CRC XOR-ed with LLID."

