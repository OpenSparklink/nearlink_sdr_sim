#: ../../../src/nearlink_sdr/node.py:526
msgid "整合链路管理、安全、QoS、PHY 流水线、跳频、功率控制、 时序调度、接入流程、信道模型为统一收发接口。"
msgstr ""
"Integrates link management, security, QoS, PHY pipeline, frequency hopping, "
"power control, timing scheduling, access procedures, and channel model into "
"a unified transceive interface."

#: ../../../src/nearlink_sdr/node.py:529
msgid "用法::"
msgstr "usage::"

#: ../../../src/nearlink_sdr/node.py:598
msgid "进入广播态, 构建并返回扩展广播帧。"
msgstr "Enter broadcast state and build an extended broadcast frame."

#: ../../../src/nearlink_sdr/node.py:606
msgid "进入扫描态, 搜索广播节点。"
msgstr "Enter scanning state and search for broadcasting nodes."

#: ../../../src/nearlink_sdr/node.py:614
msgid "处理收到的广播帧。"
msgstr "Process a received broadcast frame."

#: ../../../src/nearlink_sdr/node.py:616
msgid "在扫描态时, 通过发现管理器和广播过滤器处理帧。"
msgstr ""
"In scanning state, process the frame through the discovery manager and "
"broadcast filter."

#: ../../apidocs/nearlink_sdr/nearlink_sdr.node.md
msgid "返回"
msgstr "Returns"

#: ../../../src/nearlink_sdr/node.py:618
msgid "True 表示该帧包含有效的接入资源配置。"
msgstr "True if the frame contains a valid access resource configuration."

#: ../../../src/nearlink_sdr/node.py:622
msgid "发起接入请求。"
msgstr "Initiate an access request."

#: ../../../src/nearlink_sdr/node.py:630
msgid "接受接入请求, 直接进入链接态。"
msgstr "Accept an access request and enter linked state directly."

#: ../../../src/nearlink_sdr/node.py:632
msgid "接入完成后自动注册链路调度资源。"
msgstr ""
"Automatically register link scheduling resources after access completion."

#: ../../../src/nearlink_sdr/node.py:638
msgid "执行完整接入编排流程。"
msgstr "Execute the full access orchestration procedure."

#: ../../../src/nearlink_sdr/node.py:646
msgid "断开连接。"
msgstr "Disconnect."

#: ../../../src/nearlink_sdr/node.py:654
msgid "重置到初始状态。"
msgstr "Reset to initial state."

#: ../../../src/nearlink_sdr/node.py:662
msgid "发起配对流程。"
msgstr "Initiate pairing procedure."

#: ../../../src/nearlink_sdr/node.py:664
msgid "待发送给对端的配对信令列表。"
msgstr "List of pairing signaling messages to send to the peer."

#: ../../../src/nearlink_sdr/node.py:670
msgid "处理收到的配对信令。"
msgstr "Process a received pairing signaling message."

#: ../../../src/nearlink_sdr/node.py:672
msgid "待发送的响应信令列表。"
msgstr "List of response signaling messages to send."

#: ../../../src/nearlink_sdr/node.py:678
msgid "提交数据到发送队列。"
msgstr "Submit data to the transmit queue."

#: ../../../src/nearlink_sdr/node.py:686
msgid "从发送队列取出数据, 构建帧并生成 IQ 信号。"
msgstr ""
"Dequeue data from the transmit queue, build a frame, and generate IQ "
"signals."

#: ../../../src/nearlink_sdr/node.py:688
msgid "自动选择当前跳频信道, 更新发射功率。"
msgstr ""
"Automatically select the current hopping channel and update transmit power."

#: ../../../src/nearlink_sdr/node.py:694
msgid "从 IQ 信号解码数据。"
msgstr "from IQ signaldecodedata."

#: ../../../src/nearlink_sdr/node.py:696
msgid "如果配置了信道模型, 会在解码前应用信道效应。"
msgstr ""
"If a channel model is configured, channel effects are applied before "
"decoding."

#: ../../../src/nearlink_sdr/node.py:702
msgid "处理对端 ACK/NACK 反馈。"
msgstr "Process ACK/NACK feedback from the peer."

#: ../../../src/nearlink_sdr/node.py:720
msgid "当前跳频信道号。"
msgstr "Current frequency hopping channel number."

#: ../../../src/nearlink_sdr/node.py:728
msgid "阻塞指定信道。"
msgstr "Block a specified channel."

#: ../../../src/nearlink_sdr/node.py:736
msgid "解除信道阻塞。"
msgstr "Unblock a channel."

#: ../../../src/nearlink_sdr/node.py:762
msgid "调整发射功率, 返回调整后的功率值。"
msgstr "Adjust transmit power and return the adjusted power value."

#: ../../../src/nearlink_sdr/node.py:779
msgid "推进时隙计数器。"
msgstr "Advance the slot counter."

#: ../../../src/nearlink_sdr/node.py:796
msgid "配置 SMF 调度参数。"
msgstr "Configure SMF scheduling parameters."

#: ../../../src/nearlink_sdr/node.py:831
msgid "设置广播帧过滤器。"
msgstr "Set the broadcast frame filter."

#: ../../../src/nearlink_sdr/node.py:839
msgid "发送非链接态广播数据帧。"
msgstr "Send non-connected state broadcast data frame."

#: ../../../src/nearlink_sdr/node.py:856
msgid "配置仿真信道模型。"
msgstr "Configure the simulation channel model."

#: ../../../src/nearlink_sdr/node.py:864
msgid "清除信道模型 (恢复理想信道)。"
msgstr "Clear the channel model (restore ideal channel)."

#: ../../../src/nearlink_sdr/node.py:890
#, fuzzy
msgid "打开 SDR/USRP 硬件收发器。"
msgstr "open USRP hardware transceiver."

#: ../../../src/nearlink_sdr/node.py:898
#, fuzzy
msgid "关闭 SDR/USRP 硬件收发器。"
msgstr "close USRP hardware transceiver."

#: ../../../src/nearlink_sdr/node.py:906
#, fuzzy
msgid "从 SDR/USRP 接收 IQ 采样。"
msgstr "Receive IQ samples from USRP."

#: ../../../src/nearlink_sdr/node.py:914
msgid "生成窄带测量信号 (标准 6.2.4)。"
msgstr "Generate a narrowband measurement signal (standard clause 6.2.4)."

#: ../../../src/nearlink_sdr/node.py:931
msgid "通过链路管理器发送控制面信令。"
msgstr "Send control-plane signaling through the link manager."

#: ../../../src/nearlink_sdr/node.py:939
msgid "处理收到的控制面信令。"
msgstr "Process received control-plane signaling."

#: ../../../src/nearlink_sdr/node.py:948
msgid "返回节点统计信息。"
msgstr "Return node statistics."

#: ../../../src/nearlink_sdr/node.py:957
msgid "基于链路质量建议的 MCS 索引。"
msgstr "Recommended MCS index based on link quality."

#: ../../../src/nearlink_sdr/node.py:965
msgid "更新 MCS 索引。"
msgstr "Update the MCS index."

